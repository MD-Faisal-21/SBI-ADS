# ============================================================
# SBI-ADS configuration template
# Copy this file to `.env` and adjust the values.
# Every setting is optional — sensible defaults are built in.
# ============================================================

# --- Application ---
SBI_MAX_UPLOAD_MB=25
SBI_CURRENCY_SYMBOL=₹
SBI_NUMBER_LOCALE=en-IN

# --- Database ---
# "sqlite" (default, zero-config) or "mysql".
# MySQL is also auto-selected when SBI_DB_HOST is set.
SBI_DB_DRIVER=sqlite
# SBI_DB_HOST=localhost
# SBI_DB_PORT=3306
# SBI_DB_USER=root
# SBI_DB_PASSWORD=admin
# SBI_DB_NAME=sbi_ads
# SBI_SQLITE_PATH=data/sbi_ads.db

# --- Machine learning ---
SBI_SAFETY_BUFFER=0.10
SBI_ANOMALY_Z_THRESHOLD=3.0
